# ─── AI provider ────────────────────────────────────────────────────────────
# anthropic | openai | gemini | demo   (demo = retrieval-only, no model, clearly labelled in the UI)
AI_PROVIDER=demo
# Only the key for the provider you choose is needed. Keys stay on the server.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides. AI_MODEL is used for agent answers and final steps,
# AI_MODEL_FAST for intermediate Intelligence Network steps. Leave empty for the defaults.
AI_MODEL=
AI_MODEL_FAST=
# Optional: extra models to try first when the main one is busy. A built-in backup chain
# (see src/lib/ai/gemini.ts) always follows, so this can stay empty.
AI_FALLBACK_MODELS=
# Optional: shows model-level health details on a deployed site at
#   /api/agents/status?probe=all&token=<this value>
AI_DEBUG_TOKEN=

# ─── GitHub data pipeline ───────────────────────────────────────────────────
GITHUB_USER=arshdeepsingh11
# Optional fine-grained token with public read access. Raises the limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# ─── Certificates ───────────────────────────────────────────────────────────
# Secret for signing short-lived certificate image URLs (recommended; if empty, one is derived from your AI key). Use 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CERT_SIGNING_SECRET=

# ─── Contact email (optional) ───────────────────────────────────────────────
# With both set, the contact form sends through Resend. Without them, the UI offers a mailto fallback
# and never claims a message was sent.
RESEND_API_KEY=
CONTACT_TO=arsh.016vs@gmail.com
# Must be an address on a domain verified in Resend.
CONTACT_FROM=
